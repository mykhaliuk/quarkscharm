{
  "name": "quarkscharm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint app server shared scripts tests e2e *.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck",
    "test:unit": "bun test tests/unit",
    "rules:sync": "node scripts/sync-rules.js",
    "commits:check": "node scripts/check-commits.js",
    "spec:check": "openspec validate --all --strict --no-interactive && openspec validate --archived --no-interactive",
    "spec:status": "openspec list",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test:unit && bun run ds:check && bun run spec:check",
    "ds:sync": "node scripts/ds-sync.js",
    "ds:check": "node scripts/ds-check.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.12.0",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.13"
  }
}
