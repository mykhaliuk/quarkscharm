{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["node_modules", ".nuxt", ".output", "dist", "**/docs/**"],
  "rules": {
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_workflows", "_links", "_isReadOnly", "_audit"]
      }
    ]
  }
}
