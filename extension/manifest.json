{
  "manifest_version": 3,
  "name": "quarksCharm token bridge",
  "version": "0.1.0",
  "description": "Gives the quarksUp token of this browser to quarksCharm, and to no other site.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://*.quarksup.net/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.quarksup.net/*"],
      "exclude_matches": [
        "https://login.quarksup.net/*",
        "https://api.quarksup.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["https://quarkscharm.vercel.app/*"]
  }
}
